# Subscription backends need no Firecrawl or model API keys.
RESEARCH_PROVIDER="codex"
SEARCH_PROVIDER="agent"
# For Claude Code, set RESEARCH_PROVIDER="claude-code" and run claude auth login.
# CLAUDE_MODEL="sonnet"
# CLAUDE_PATH="absolute/path/to/claude"
# CLAUDE_TIMEOUT_MS="600000"
# RESEARCH_CONCURRENCY="1"

# Optional alternative: SEARCH_PROVIDER="firecrawl"
# FIRECRAWL_KEY="YOUR_KEY"
# If you want to use your self-hosted Firecrawl, add the following below:
# FIRECRAWL_BASE_URL="http://localhost:3002"
# FIRECRAWL_CONCURRENCY="2"

# Optional: select a model available to your ChatGPT plan.
# CODEX_MODEL="your_model"
# CODEX_PATH="absolute/path/to/codex"
# CODEX_TIMEOUT_MS="600000"
# API billing is only enabled by explicitly selecting RESEARCH_PROVIDER="api".
# OPENAI_KEY="YOUR_KEY"
CONTEXT_SIZE="128000"

# If you want to use other OpenAI compatible API, add the following below:
# OPENAI_ENDPOINT="http://localhost:11434/v1"
# CUSTOM_MODEL="llama3.1"

# If you want to use fireworks.ai's DeepSeek R1 model:
# FIREWORKS_KEY="YOUR_KEY"
